    {
      "parameters": {
        "jsCode": "const task = $json.task || \"\";\nconst id = $json.id || null;\n\nlet result;\nlet reasoning;\n\nif (typeof task !== \"string\") {\n  return [{\n    json: {\n      id: id,\n      task: \"\",\n      tool: \"calculate\",\n      result: \"Invalid task format.\",\n      reasoning: \"Task was not a valid string.\"\n    }\n  }];\n}\n\ntry {\n  const numbers = task.match(/-?\\d+(\\.\\d+)?/g);\n\n  if (numbers && numbers.length >= 2) {\n    const values = numbers.map(Number);\n    result = values.reduce((a, b) => a + b, 0);\n    reasoning = `Detected numbers: ${values.join(\", \")}. Computed sum.`;\n  } \n  else if (numbers && numbers.length === 1) {\n    result = Number(numbers[0]);\n    reasoning = `Single numeric value detected: ${result}.`;\n  } \n  else {\n    result = null;\n    reasoning = \"No numeric values found. Calculation skipped.\";\n  }\n\n} catch (error) {\n  result = null;\n  reasoning = \"Error during calculation.\";\n}\n\nreturn [{\n  json: {\n    id: id,\n    task: task,\n    tool: \"calculate\",\n    result: result !== null \n      ? `Calculation Result: ${result}` \n      : \"No valid numeric computation performed.\",\n    reasoning: reasoning\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
